+//! One-shot UICR fix: unpin the reset line (PSELRESET[1] = 0x10).
+//!
+//! Writes only when the UICR is exactly in the state of a Feitian dongle with the bootloader
+//! at 0xE0000 and both PSELRESET words equal to 0x12. Any other state is left untouched. No
+//! erase, no retry, no panic.
+
+use nrf52840_hal::pac::NVMC;
+
+const UICR_NRFFW0: *const u32 = 0x1000_1014 as *const u32;
+const UICR_PSELRESET0: *const u32 = 0x1000_1200 as *const u32;
+const UICR_PSELRESET1: *mut u32 = 0x1000_1204 as *mut u32;
+
+const BOOTLOADER_ADDR: u32 = 0x000E_0000;
+const PSELRESET_P0_18: u32 = 0x0000_0012;
+const PSELRESET_UNPINNED: u32 = 0x0000_0010;
+
+const CONFIG_REN: u32 = 0;
+const CONFIG_WEN: u32 = 1;
+
+fn wait_ready(nvmc: &NVMC) {
+    while nvmc.ready.read().ready().is_busy() {}
+}
+
+fn set_config(nvmc: &NVMC, bits: u32) {
+    // SAFETY: CONFIG accepts REN (0) and WEN (1).
+    nvmc.config.write(|w| unsafe { w.bits(bits) });
+    wait_ready(nvmc);
+}
+
+pub fn run(nvmc: &NVMC) {
+    // SAFETY: Fixed, always-mapped UICR addresses (word aligned).
+    let (fw, p0, p1) = unsafe {
+        (
+            core::ptr::read_volatile(UICR_NRFFW0),
+            core::ptr::read_volatile(UICR_PSELRESET0),
+            core::ptr::read_volatile(UICR_PSELRESET1),
+        )
+    };
+    if fw != BOOTLOADER_ADDR || p0 != PSELRESET_P0_18 || p1 != PSELRESET_P0_18 {
+        return;
+    }
+    set_config(nvmc, CONFIG_WEN);
+    // SAFETY: Single word write to an erased-bit-compatible UICR word with WEN enabled.
+    unsafe { core::ptr::write_volatile(UICR_PSELRESET1, PSELRESET_UNPINNED) };
+    wait_ready(nvmc);
+    set_config(nvmc, CONFIG_REN);
+}
